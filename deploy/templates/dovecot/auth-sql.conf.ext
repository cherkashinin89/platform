# ============================================================
# Dovecot 2.4: SQL-аутентификация (PostgreSQL)
# ============================================================

# --- Подключение к PostgreSQL (синтаксис Dovecot 2.4) ---
pgsql 127.0.0.1 {
  parameters {
    user = __MAIL_DB_USER__
    password = __MAIL_DB_PASSWORD__
    dbname = __MAIL_DB_NAME__
  }
}

# --- PassDB: проверка пароля (из User.password_hash, Argon2id) ---
passdb sql {
  sql_driver = pgsql
  passdb_sql_query = SELECT u.password_hash AS password, \
    '/var/vmail/%{user | domain}/%{user | username}' AS userdb_home, \
    5000 AS userdb_uid, \
    5000 AS userdb_gid, \
    (m.quota_bytes || 'B') AS userdb_quota_storage_size \
    FROM "user" u \
    JOIN mailbox m ON m.user_id = u.id \
    JOIN mail_domain d ON d.id = m.domain_id \
    WHERE m.local_part = '%{user | username}' \
      AND d.name = '%{user | domain}' \
      AND m.is_active = true \
      AND d.is_active = true
}

# --- UserDB: home, uid, gid, квота ---
userdb sql {
  sql_driver = pgsql
  userdb_sql_query = SELECT '/var/vmail/%{user | domain}/%{user | username}' AS home, \
    5000 AS uid, \
    5000 AS gid, \
    (m.quota_bytes || 'B') AS quota_storage_size \
    FROM mailbox m \
    JOIN mail_domain d ON d.id = m.domain_id \
    WHERE m.local_part = '%{user | username}' \
      AND d.name = '%{user | domain}' \
      AND m.is_active = true \
      AND d.is_active = true
}

# --- W47: Master-user для mail-сервиса (Dovecot 2.4) ---
# Формат входа: loginuser*masteruser (например, test@testprod2.local*master)
passdb passwd-file {
  passwd_file_path = /etc/dovecot/master-users
  master = yes
  result_success = continue
}


