# ============================================================
# Пример .env для экосистемы platform
#
# Скопировать в /home/deploy/apps/platform/.env и заполнить:
#     cp deploy/env.example .env
#     chmod 600 .env
# ============================================================

# === Секретный ключ (ОБЩИЙ для SSO) ===
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex-string

# === База данных (ОБЩАЯ для framework и cloud) ===
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://myframework:change-me@127.0.0.1:5432/myframework

# === Корень облачного хранилища (ОБЩИЙ) ===
# В проде: /home/deploy/apps/platform/cloud/cloud_data
CLOUD_DATA_ROOT=/home/deploy/apps/platform/cloud/cloud_data

# === Внешний диск для бэкапов (только framework) ===
EXTERNAL_BACKUP_PATH=/mnt/backup
# Ключ для внутренних запросов framework → cloud (создание шар от имени пользователя)
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=change_me_please